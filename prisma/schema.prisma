// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 

  product Product[]
  stockmovement StockMovement[]
  storeVisit StoreVisit[]
  dailyReports DailyReport[] @relation("AgentDailyReports")
  verifiedReports DailyReport[] @relation("VerifiedDailyReports")
  quotas AgentQuota[]
  locations AgentLocation[]
}

model Brand {
  id        String   @id @default(uuid())
  brand_name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  model Model[]
}

model Model {
  id        String   @id @default(uuid())
  brand_id  String
  brand    Brand    @relation(fields: [brand_id], references: [id])
  model_name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  product Product[]
}

model Product {
  id        String   @id @default(uuid())
  model_id String
  model    Model    @relation(fields: [model_id], references: [id])
  product_name String
  price Decimal @db.Decimal(10, 2)
  category Category
  created_by String
  user    User    @relation(fields: [created_by], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([category, deletedAt])
  inventory Inventory?
  stockmovement StockMovement[]
  transactionItem TransactionItem[]
  storeInventory StoreInventory[]

}

model Inventory {
  id        String   @id @default(uuid())
  product_id String @unique
  product    Product    @relation(fields: [product_id], references: [id])
  quantity Int
  reorder_level Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([product_id])
}

model StockMovement {
  id        String   @id @default(uuid())
  product_id String
  product    Product    @relation(fields: [product_id], references: [id])
  store_id    String?
  store       Customer? @relation(fields: [store_id], references: [id])
  type Type
  quantity Int
  createdAt DateTime @default(now())
  created_by String
  user    User    @relation(fields: [created_by], references: [id])

  @@index([product_id])
  @@index([created_by])
  @@index([createdAt])
  @@index([product_id, createdAt])
}

model Customer {
  id        String   @id @default(uuid())
  store_name String
  owner_name String
  address String
  contact_number String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  
  storeVisit StoreVisit[]
  storeInventory StoreInventory[]
  stockMovement StockMovement[]

}

model DeliveryReport {
  id        String   @id @default(uuid())
  storeVisit    StoreVisit    @relation(fields: [store_visit_id], references: [id])
  store_visit_id String
  date DateTime
  remarks String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  gpsLog GpsLog[]
  imageEvidence ImageEvidence[]
}

model GpsLog {
  id        String   @id @default(uuid())
  deliveryReport    DeliveryReport    @relation(fields: [delivery_id], references: [id])
  delivery_id String
  latitude Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImageEvidence {
  id        String   @id @default(uuid())
  deliveryReport    DeliveryReport    @relation(fields: [delivery_id], references: [id])
  delivery_id String
  image_path String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id              String   @id @default(uuid())
  code            String   @unique
  discountType    DiscountType
  discountValue   Float    
  maxUsage        Int?     
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  transactions    Transaction[]
}

model StoreVisit {
  id              String   @id @default(uuid())
  user    User    @relation(fields: [user_id], references: [id])
  user_id String
  customer    Customer    @relation(fields: [customer_id], references: [id])
  customer_id String
  time_in  DateTime?
  time_out DateTime?
  visit_date DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt DateTime?

  deliveryReports DeliveryReport[]
  transaction Transaction[]
  locations AgentLocation[]

  @@unique([user_id, customer_id, visit_date])

}

model Transaction {
  id              String   @id @default(uuid())

  store_visit_id  String
  storeVisit      StoreVisit @relation(fields: [store_visit_id], references: [id])

  type            TransactionType
  promo_code_id   String?
  promoCode       PromoCode? @relation(fields: [promo_code_id], references: [id])
  subtotal_amount Decimal? @db.Decimal(10,2)
  discount_amount Decimal? @db.Decimal(10,2)
  total_amount    Decimal? @db.Decimal(10,2)

  createdAt       DateTime @default(now())

  items           TransactionItem[]

  @@index([promo_code_id])
  @@index([createdAt])
}

model DailyReport {
  id              String @id @default(uuid())
  user_id         String
  user            User @relation("AgentDailyReports", fields: [user_id], references: [id])
  report_date     DateTime
  summary         String
  corrected_summary String?
  status          DailyReportStatus @default(SUBMITTED)
  admin_remarks   String?
  verified_by     String?
  verifiedBy      User? @relation("VerifiedDailyReports", fields: [verified_by], references: [id])
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?

  @@unique([user_id, report_date])
  @@index([report_date])
  @@index([status])
}

model AgentQuota {
  id              String @id @default(uuid())
  user_id         String
  user            User @relation(fields: [user_id], references: [id])
  period_start    DateTime
  period_end      DateTime
  target_amount   Decimal @db.Decimal(12,2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([user_id, period_start, period_end])
  @@index([period_start, period_end])
}

model AgentLocation {
  id              String @id @default(uuid())
  user_id         String
  user            User @relation(fields: [user_id], references: [id])
  store_visit_id  String?
  storeVisit      StoreVisit? @relation(fields: [store_visit_id], references: [id])
  latitude        Float
  longitude       Float
  recordedAt      DateTime @default(now())

  @@index([user_id, recordedAt])
  @@index([store_visit_id])
}

model TransactionItem {
  id              String   @id @default(uuid())

  transaction_id  String
  transaction     Transaction @relation(fields: [transaction_id], references: [id])

  product_id      String
  product         Product @relation(fields: [product_id], references: [id])

  quantity        Int
  price           Decimal? @db.Decimal(10,2)
}

model StoreInventory {
  id          String   @id @default(uuid())

  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id])

  product_id  String
  product     Product @relation(fields: [product_id], references: [id])

  quantity    Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([customer_id, product_id])
  @@index([customer_id])
  @@index([product_id])
}

enum TransactionType {
  SALE
  DELIVERY
}

enum DailyReportStatus {
  SUBMITTED
  VERIFIED
  CORRECTED
}


enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum Role {
  USER
  ADMIN
}

enum Category {
  Electronics
  Apparel
  Books
  Toys
  Furniture
  Misc
}

enum Type {
  IN
  OUT
  ADJUSTMENT
}
